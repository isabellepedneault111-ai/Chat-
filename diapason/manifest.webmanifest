{
  "name": "Diapason Labo · FLIP",
  "short_name": "FLIP",
  "description": "Le laboratoire de FLIP : Zaza et Frog.",
  "lang": "fr-CA",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#1b1916",
  "theme_color": "#1b1916",
  "icons": [
    {
      "src": "img/icone-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "img/icone-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./#/oreille",
      "accept": {
        "audio/mp4": [
          ".m4a",
          ".mp4"
        ],
        "audio/x-m4a": [
          ".m4a"
        ],
        "video/quicktime": [
          ".qta",
          ".mov"
        ],
        "audio/mpeg": [
          ".mp3"
        ],
        "audio/wav": [
          ".wav"
        ],
        "audio/x-wav": [
          ".wav"
        ],
        "audio/aiff": [
          ".aif",
          ".aiff"
        ],
        "audio/x-caf": [
          ".caf"
        ],
        "audio/aac": [
          ".aac"
        ],
        "audio/flac": [
          ".flac"
        ],
        "audio/ogg": [
          ".ogg",
          ".opus"
        ]
      },
      "launch_type": "single-client"
    }
  ]
}